# =============================================================================
# Central Inteligente de Cotacoes e Ativos - exemplo de variaveis de ambiente
# -----------------------------------------------------------------------------
# ESTE ARQUIVO E UM TEMPLATE VERSIONAVEL. Mantenha todos os valores VAZIOS.
# E o unico arquivo .env liberado pelo .gitignore (regra `!.env.example`),
# portanto qualquer valor real escrito aqui vaza ao versionar o projeto.
#
# Copie este arquivo para `.env.local` e preencha os valores reais la.
# `.env.local` esta no .gitignore e NUNCA deve ser versionado.
#
# Nenhuma variavel aqui usa o prefixo NEXT_PUBLIC_: todos os valores ficam
# exclusivamente no servidor e nunca sao enviados ao navegador.
# =============================================================================

# Chave Demo opcional da CoinGecko.
# A aplicacao funciona sem ela, usando o acesso publico.
# Obtenha em: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Personal Access Token do Airtable (escopos: data.records:read, data.records:write).
# Sem esta variavel a aplicacao roda em modo memoria e avisa isso na interface.
AIRTABLE_TOKEN=

# Identificador da base do Airtable (formato appXXXXXXXXXXXXXX).
AIRTABLE_BASE_ID=

# Nomes das tabelas dentro da base.
AIRTABLE_TABLE_ASSETS=Ativos
AIRTABLE_TABLE_RULES=Regras
AIRTABLE_TABLE_ALERTS=Alertas

# Tempo de vida do cache de cotacoes, em segundos (padrao 300 = 5 minutos).
CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Ajustes opcionais (possuem padrao no codigo; descomente para sobrescrever)
# -----------------------------------------------------------------------------

# Janela, em minutos, que impede a recriacao de um alerta identico (padrao 30).
# ALERT_DEDUP_MINUTES=30

# Idade, em segundos, a partir da qual uma cotacao e marcada como
# desatualizada na interface (padrao 900 = 15 minutos).
# QUOTE_STALE_THRESHOLD_SECONDS=900

# Intervalo minimo, em segundos, entre duas atualizacoes manuais (padrao 20).
# FORCED_REFRESH_COOLDOWN_SECONDS=20
